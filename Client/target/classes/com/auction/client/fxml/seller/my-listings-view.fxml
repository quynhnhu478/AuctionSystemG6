<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" stylesheets="@../../css/style_2.css" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.seller.MyListingsUnderViewController">
   <content>
      <VBox fx:id="rootVBox" alignment="CENTER" prefHeight="289.0" prefWidth="602.0" spacing="20.0" styleClass="main-content">
         <children>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../images/groceries.png" />
               </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="label-title" text="You haven't created any listings" />
                  <Label styleClass="label-subtitle" text="Start selling by creating your first listing" />
               </children>
            </VBox>

            <Button fx:id="addItemButton" mnemonicParsing="false" onAction="#openAddProductDialog" styleClass="gold-button" text="+ Add Item" />

            <Label styleClass="label-subtitle" text="Tip: High-quality photos help your items sell faster" />
         </children>
      </VBox>
   </content>
</ScrollPane>
