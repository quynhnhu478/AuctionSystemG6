               </padding>
            </Label>
            <VBox layoutX="446.0" layoutY="152.0" prefHeight="334.0" prefWidth="329.0" spacing="5.0" AnchorPane.leftAnchor="620.0" AnchorPane.rightAnchor="330.6666666666667" AnchorPane.topAnchor="220.0">
