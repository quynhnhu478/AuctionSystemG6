<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f3e9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.admin.AdminTransactionsController">

    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #523c34;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" prefHeight="85.0" style="-fx-border-color: #b3857a; -fx-border-width: 0 0 2 0; -fx-background-color: #402e28;">
                    <children>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                            <children>
                                <ImageView fx:id="avatar" fitHeight="33.0" fitWidth="36.0" onMouseClicked="#OpenLogoutDialog" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/user.png" />
                                    </image>
                                </ImageView>
                                <Label text="AUCTION ADMIN" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets left="12.0" right="12.0" top="20.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnManageAuctions" alignment="BASELINE_LEFT" maxWidth="1.5e308" mnemonicParsing="false" onAction="#switchToManageAuctionsButton" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #e0dcd3; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text=" 🔨   Manage Auctions">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnManageUsers" alignment="BASELINE_LEFT" maxWidth="1.5e308" mnemonicParsing="false" onAction="#switchToManageUserButton" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #e0dcd3; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text=" 👥   Manage Users">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnTransactions" alignment="BASELINE_LEFT" maxWidth="1.5e308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #b79282; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text=" 💳   Transactions">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="240.0" spacing="10.0" style="-fx-border-color: #402e28; -fx-border-width: 1 0 0 0; -fx-padding: 0 15 0 15;">
                    <children>
                        <Label text="System Administrator" textFill="#c4bfae">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Transactions Management" textFill="#523c34">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label text="Track financial logs, system deposit/withdrawal activities, and auction payments." textFill="#7A706B">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Button fx:id="btnViewDetail" mnemonicParsing="false"  prefHeight="38.0" style="-fx-background-color: #b79282; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 16 0 16;" text="📄 View Detail" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="45.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 0 15 0 15; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 8;">
                    <children>
                        <Label text="Search Logs:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtSearchTransaction" prefHeight="30.0" prefWidth="250.0" promptText="Enter TxID, username..." style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-width: 0 0 1 0;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Type:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cbTransactionType" prefHeight="30.0" prefWidth="130.0" promptText="All Types" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />

                        <Label text="Status:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cbTransactionStatus" prefHeight="30.0" prefWidth="130.0" promptText="All Status" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />
                    </children>
                </HBox>

                <TableView fx:id="tblTransactions" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #CBD5E1; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTxId" prefWidth="100.0" text="Transaction ID" />
                        <TableColumn fx:id="colUsername" prefWidth="160.0" text="Username" />
                        <TableColumn fx:id="colType" prefWidth="140.0" text="Type" />
                        <TableColumn fx:id="colAmount" prefWidth="150.0" text="Amount" />
                        <TableColumn fx:id="colTimestamp" prefWidth="180.0" text="Date &amp; Time" />
                        <TableColumn fx:id="colDescription" prefWidth="250.0" text="Description" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>
