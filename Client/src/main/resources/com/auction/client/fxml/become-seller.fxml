<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Register as a Seller" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label text="Authentication is required to ensure the safety of the auction community" textAlignment="CENTER" textFill="#555555" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="15.0" />
         </VBox.margin>
      </VBox>

      <GridPane hgap="15.0" vgap="15.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <VBox spacing="5.0" GridPane.columnSpan="2">
               <children>
                  <Label text="Shop name / Seller name">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" style="-fx-background-radius: 5; -fx-border-color: #D3D3D3; -fx-border-radius: 5; -fx-background-color: #FFFFFF;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.rowIndex="1">
               <children>
                  <Label text="Identity Number">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" style="-fx-background-radius: 5; -fx-border-color: #D3D3D3; -fx-border-radius: 5; -fx-background-color: #FFFFFF;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label text="Phone number">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" style="-fx-background-radius: 5; -fx-border-color: #D3D3D3; -fx-border-radius: 5; -fx-background-color: #FFFFFF;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="2">
               <children>
                  <Label text="Email">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" style="-fx-background-radius: 5; -fx-border-color: #D3D3D3; -fx-border-radius: 5; -fx-background-color: #FFFFFF;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
               <children>
                  <Label text="Address">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" style="-fx-background-radius: 5; -fx-border-color: #D3D3D3; -fx-border-radius: 5; -fx-background-color: #FFFFFF;" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" spacing="0.0">
         <children>
            <CheckBox mnemonicParsing="false" text="I agree to ">
               <font>
                  <Font size="13.0" />
               </font>
            </CheckBox>
            <Hyperlink text="Terms &amp; Conditions" style="-fx-underline: true; -fx-text-fill: #4A80F0; -fx-padding: 0 0 0 -3;">
               <font>
                  <Font size="13.0" />
               </font>
            </Hyperlink>
         </children>
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
      </HBox>

      <HBox alignment="CENTER" spacing="80.0">
         <children>
            <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: #EAEAEA; -fx-background-radius: 8; -fx-text-fill: #4A80F0;" text="Cancel">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: #4A80F0; -fx-background-radius: 8; -fx-text-fill: #FFFFFF;" text="Continue">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>