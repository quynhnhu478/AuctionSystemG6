<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="320.0" prefHeight="400.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #dcdcdc; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://fxml.com/fx/1" fx:controller="com.auction.client.controller.NotificationDialogController">
    <children>
        <VBox alignment="CENTER_LEFT" prefHeight="45.0" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent transparent #e9ecef transparent; -fx-border-width: 1; -fx-padding: 0 15 0 15;">
            <children>
                <Label text="Thông báo gần đây" textFill="#495057">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <ListView fx:id="notificationListView" prefHeight="355.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 5;" />
    </children>
</VBox>