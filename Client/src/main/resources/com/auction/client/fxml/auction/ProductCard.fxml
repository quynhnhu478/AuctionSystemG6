<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="420.0" maxWidth="290.0" minHeight="420.0" minWidth="290.0" prefHeight="420.0" prefWidth="290.0" style="-fx-background-color: white; -fx-border-color: #b3857a; -fx-border-width: 2; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 5);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.auction.ProductCardController">
    <children>

        <VBox alignment="CENTER" maxHeight="165.0" minHeight="165.0" prefHeight="165.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 11 11 0 0;">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="165.0" fitWidth="286.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </VBox>

        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="14.0" left="16.0" right="16.0" top="12.0" />
            </padding>
            <children>

                <Label fx:id="lblItemName" prefHeight="44.0" style="-fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 14.5px;" text="Product Name" wrapText="true" />

                <Label fx:id="lblDescription" style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Product description will be shown here..." />

                <HBox spacing="8.0">
                    <children>
                        <Label fx:id="lblCategory" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 3 10 3 10; -fx-font-weight: bold; -fx-font-size: 11;" text="Category" />
                        <Label fx:id="lblStatus" style="-fx-background-color: #DCFCE7; -fx-text-fill: #16A34A; -fx-background-radius: 6; -fx-padding: 3 10 3 10; -fx-font-weight: bold; -fx-font-size: 11;" text="OPEN" />
                    </children>
                </HBox>

                <VBox spacing="6.0" style="-fx-border-color: #F1F5F9; -fx-border-width: 1 0 1 0; -fx-padding: 8 0 8 0;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Current price:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblPrice" style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 14.5px;" text="\$0.00" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Number of bids:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblBidCount" style="-fx-text-fill: #EF4444; -fx-font-weight: bold; -fx-font-size: 13.5px;" text="0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Time remaining:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTimeRemaining" style="-fx-text-fill: #3B82F6; -fx-font-weight: bold; -fx-font-size: 13.5px;" text="00h 00m 00s" />
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnPlaceBid" maxWidth="200.0" mnemonicParsing="false" prefHeight="34.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" text="Place Bid" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAutoBid" maxWidth="200.0" mnemonicParsing="false" prefHeight="34.0" style="-fx-background-color: #94A3B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" text="Auto-Bid" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
