<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-padding: 0;" styleClass="root-pane" stylesheets="@../../css/style_2.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LiveAuctionsController">
    <content>
        <VBox alignment="CENTER" prefHeight="289.0" prefWidth="602.0" spacing="30.0" style="-fx-background-color: #f4f3e9;" styleClass="main-content">
            <children>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../images/bidder.png" />
               </image>
            </ImageView>

                <VBox alignment="CENTER" spacing="6.0">
                    <children>
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #523c34; -fx-font-family: 'System';" text="No auctions yet" />
                  <Label style="-fx-font-size: 14px; -fx-text-fill: #7a6e67; -fx-font-family: 'System';" text="Sellers haven't listed any items. Check back soon!" />
                    </children>
                </VBox>

                <Button mnemonicParsing="false" onAction="#openRegisterDialog" style="-fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 24 10 24; -fx-background-radius: 16; -fx-cursor: hand; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-width: 2; -fx-border-color: #000000; -fx-background-color: #f4db65;" text="Become a Seller" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #9a8e87; -fx-font-style: italic;" text="Be the first to start an auction" />
            </children>
        </VBox>
    </content>
</ScrollPane>
