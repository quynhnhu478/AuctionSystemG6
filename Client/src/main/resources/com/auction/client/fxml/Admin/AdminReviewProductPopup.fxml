<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="540.0" maxWidth="800.0" minHeight="540.0" minWidth="800.0" prefHeight="540.0" prefWidth="800.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #b3857a; -fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.admin.AdminReviewProductPopUpController">
    <children>

        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-border-color: #F1F5F9; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="24.0" right="24.0" />
            </padding>
            <children>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Review Pending Product" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label text="Please review seller's product details carefully before approving" textFill="#64748B" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="24.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>

                <VBox maxWidth="340.0" minWidth="340.0" prefWidth="340.0" spacing="10.0">
                    <children>
                        <Label text="Product Image" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <VBox alignment="CENTER" maxHeight="240.0" prefHeight="240.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <ImageView fx:id="imgProductReview" fitHeight="236.0" fitWidth="336.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Product Title:" textFill="#475569"><font><Font name="System Bold" size="13.0" /></font></Label>
                                <Label fx:id="lblProductTitle" text="[Title goes here]" textFill="#1E293B" wrapText="true"><font><Font size="14.0" /></font></Label>
                            </children>
                        </VBox>

                        <HBox spacing="20.0">
                            <children>
                                <VBox minWidth="180.0" prefWidth="180.0" spacing="4.0">
                                    <children>
                                        <Label text="Seller:" textFill="#475569"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <Label fx:id="lblSellerName" text="[Seller Username]" textFill="#1E293B"><font><Font size="14.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Category:" textFill="#475569"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblCategory" style="-fx-background-color: #dae9f2; -fx-text-fill: #025f99; -fx-background-radius: 8; -fx-padding: 2 8 2 8; -fx-font-weight: bold;" text="VEHICLE" textFill="#025f99" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <VBox minWidth="180.0" prefWidth="180.0" spacing="4.0">
                                    <children>
                                        <Label text="Starting Price:" textFill="#475569"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <Label fx:id="lblStartingPrice" text="\$0.00" textFill="#10B981"><font><Font name="System Bold" size="15.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Duration:" textFill="#475569"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <Label fx:id="lblDuration" text="24 Hours" textFill="#3B82F6"><font><Font name="System Bold" size="14.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Product Description:" textFill="#475569"><font><Font name="System Bold" size="13.0" /></font></Label>
                                <TextArea fx:id="txtDescriptionReview" editable="false" prefHeight="100.0" style="-fx-background-color: #F8FAFC; -fx-control-inner-background: #F8FAFC;" wrapText="true" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" prefHeight="65.0" spacing="12.0" style="-fx-border-color: #F1F5F9; -fx-border-width: 1 0 0 0; -fx-background-color: #F8FAFC; -fx-background-radius: 0 0 15 15;">
            <padding>
                <Insets left="24.0" right="24.0" />
            </padding>
            <children>
                <Button fx:id="btnCancelPopup" mnemonicParsing="false" prefHeight="36.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: bold; -fx-cursor: hand;" text="Close" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRejectProduct" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #ed1c24; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="✕ Reject Product" />
                <Button fx:id="btnApproveProduct" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #34a842; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="✓ Approve &amp; Publish" />
            </children>
        </HBox>

    </children>
</VBox>
