<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="580.0" maxWidth="840.0" minHeight="540.0" minWidth="840.0" prefWidth="840.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #b3857a; -fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionDetailsPopupController">
    <children>

        <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-border-color: #F1F5F9; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="24.0" right="24.0" />
            </padding>
            <children>
                <Label text="Auction Details" textFill="#1E293B">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <HBox spacing="24.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" maxHeight="270.0" maxWidth="380.0" minHeight="270.0" minWidth="380.0" prefHeight="270.0" prefWidth="380.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <children>
                        <ImageView fx:id="imgProductDetails" fitHeight="268.0" fitWidth="378.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>

                        <Label fx:id="lblItemName" text="Product Name" textFill="#1E293B" wrapText="true">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Label fx:id="lblDescription" text="Product description from seller..." textFill="#64748B" wrapText="true">
                            <font>
                                <Font size="12.5" />
                            </font>
                        </Label>

                        <HBox spacing="8.0">
                            <children>
                                <Label fx:id="lblCategory" style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 3 10 3 10; -fx-font-weight: bold; -fx-font-size: 11;" text="Category" />

                                <Label fx:id="lblStatus" style="-fx-background-color: #DCFCE7; -fx-text-fill: #16A34A; -fx-background-radius: 6; -fx-padding: 3 10 3 10; -fx-font-weight: bold; -fx-font-size: 11;" text="RUNNING" />
                            </children>
                        </HBox>

                        <VBox spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Starting price:" textFill="#64748B" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblStartingPrice" text="\$0.00" textFill="#1E293B">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Current Highest Bid:" textFill="#64748B" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblCurrentHighest" text="\$0.00" textFill="#10B981">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Time remaining:" textFill="#64748B" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblTimeRemaining" text="0h 00m 00s" textFill="#3B82F6">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label fx:id="lblMinBidAlert" text="Place Your Bid (Min: $101)" textFill="#1E293B">
                                    <font>
                                        <Font name="System Bold" size="12.5" />
                                    </font>
                                </Label>
                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="txtBidAmount" prefHeight="36.0" promptText="Enter amount" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnSubmitBid" mnemonicParsing="false" prefHeight="36.0" prefWidth="70.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Bid" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblBalance" text="Your balance: $10,000" textFill="#64748B">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <HBox fx:id="paneNotification" alignment="CENTER_LEFT" managed="false" prefHeight="30.0" style="-fx-background-color: #DCFCE7; -fx-background-radius: 6; -fx-border-color: #16A34A; -fx-border-radius: 6;" visible="false">
                            <padding>
                                <Insets left="12.0" right="12.0" />
                            </padding>
                            <children>
                                <Label text="Bid placed successfully!" textFill="#16A34A">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-border-color: #F1F5F9; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                    <children>
                        <Label fx:id="lblBidHistoryCount" text="📈 Bid History (0 bids)" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="120.0" style="-fx-background-color: transparent; -fx-background-insets: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="vboxBidList" spacing="8.0" style="-fx-background-color: transparent;">
                            <children>

                                <Label fx:id="lblNoBidsYet" alignment="CENTER" maxWidth="1.5e308" text="No bids yet. Be the first to bid!" textFill="#94A3B8">
                                    <padding>
                                        <Insets top="20.0" />
                                    </padding>
                                    <font>
                                        <Font name="System Italic" size="13.0" />
                                    </font>
                                </Label>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

    </children>
</VBox>
