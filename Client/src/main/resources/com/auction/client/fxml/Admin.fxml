<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminDashboardController">

    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #1E293B;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" prefHeight="80.0" style="-fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label text="AUCTION ADMIN" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20.0" left="12.0" right="12.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnManageAuctions" alignment="BASELINE_LEFT" maxWidth="1.5e308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text=" 🔨  Manage Auctions">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnManageUsers" alignment="BASELINE_LEFT" maxWidth="1.5e308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text=" 👥  Manage Users">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnTransactions" alignment="BASELINE_LEFT" maxWidth="1.5e308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text=" 💳  Transactions">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" style="-fx-border-color: #334155; -fx-border-width: 1 0 0 0; -fx-padding: 0 15 0 15;">
                    <children>
                        <Label text="System Administrator" textFill="#94A3B8">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                    <children>
                        <VBox>
                            <children>
                                <Label text="Auctions Management" textFill="#0F172A">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label text="Review, approve, or terminate auction sessions" textFill="#64748B" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="btnApprove" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="✓ Approve Session" />
                                <Button fx:id="btnTerminate" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="🛑 Terminate" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="tblAuctions" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="colItemName" prefWidth="280.0" text="Product Name" />
                        <TableColumn fx:id="colSeller" prefWidth="140.0" text="Seller" />
                        <TableColumn fx:id="colCategory" prefWidth="130.0" text="Category" />
                        <TableColumn fx:id="colCurrentPrice" prefWidth="130.0" text="Current Price" />
                        <TableColumn fx:id="colBids" prefWidth="90.0" text="Bids" />
                        <TableColumn fx:id="colStatus" prefWidth="140.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>